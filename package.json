{
  "name": "asset-helper",
  "description": "个人资产与多市场行情查看 Chrome 扩展",
  "private": true,
  "version": "2.0.5",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "export PATH=/usr/local/bin:$PATH; node scripts/patch-rollup-native.mjs && tsc --noEmit && vite build",
    "build:extension": "export PATH=/usr/local/bin:$PATH; node scripts/patch-rollup-native.mjs && tsc --noEmit && vite build",
    "build:store": "export PATH=/usr/local/bin:$PATH; node scripts/patch-rollup-native.mjs && tsc --noEmit && vite build --minify esbuild",
    "dev": "export PATH=/usr/local/bin:$PATH; node scripts/patch-rollup-native.mjs && vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "postinstall": "node scripts/patch-rollup-native.mjs"
  },
  "dependencies": {
    "decimal.js-light": "^2.5.1",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "7.18.2",
    "recharts": "2.15.2",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/wasm-node": "4.62.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "6.4.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3",
      "esbuild@0.28.0": "0.28.1",
      "@babel/core@7.29.0": "7.29.6",
      "brace-expansion@1.1.14": "1.1.18",
      "brace-expansion@5.0.6": "5.0.9"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "lightningcss"
    ]
  }
}
